{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3AccountDiscovery",
      "Effect": "Allow",
      "Action": [
        "s3:ListAllMyBuckets"
      ],
      "Resource": "*"
    },
    {
      "Sid": "S3ForQuorumFlow",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:DeleteBucket",
        "s3:Get*",
        "s3:ListBucket",
        "s3:PutBucketTagging",
        "s3:PutBucketVersioning"
      ],
      "Resource": [
        "arn:aws:s3:::quorumflow-lake-*"
      ]
    },
    {
      "Sid": "DynamoForQuorumFlow",
      "Effect": "Allow",
      "Action": [
        "dynamodb:CreateTable",
        "dynamodb:DeleteTable",
        "dynamodb:DescribeTable",
        "dynamodb:DescribeContinuousBackups",
        "dynamodb:UpdateContinuousBackups",
        "dynamodb:ListTagsOfResource",
        "dynamodb:TagResource"
      ],
      "Resource": "arn:aws:dynamodb:*:*:table/quorumflow-raft-snapshots"
    },
    {
      "Sid": "EcrForQuorumFlow",
      "Effect": "Allow",
      "Action": [
        "ecr:CreateRepository",
        "ecr:DeleteRepository",
        "ecr:DescribeRepositories",
        "ecr:ListTagsForResource",
        "ecr:TagResource",
        "ecr:PutImageScanningConfiguration",
        "ecr:PutImageTagMutability"
      ],
      "Resource": "arn:aws:ecr:*:*:repository/quorumflow-runtime"
    }
  ]
}
